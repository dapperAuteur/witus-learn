# ── Core ───────────────────────────────────────────────────────────────────
# Neon Postgres. Pooled URL for the app runtime; unpooled (direct) for migrations.
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/witus_learn?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.region.aws.neon.tech/witus_learn?sslmode=require

# Default/marketing host (no trailing slash). Per-tenant hosts live in tenant_domains.
NEXT_PUBLIC_APP_URL=http://localhost:3040

# ── Better Auth (magic-link) ─────────────────────────────────────────────────
BETTER_AUTH_SECRET=replace-with-a-random-string-at-least-32-characters-long
# Canonical base URL. Dev: http://localhost:3040 · Prod: https://learn.witus.online
# (NOT a single tenant host — magic links are rewritten to the request's tenant
#  domain at send time, so each brand's session cookie lands on its own host.)
BETTER_AUTH_URL=http://localhost:3040
# Every tenant domain that may drive auth (comma-separated). Add prod brand hosts.
# TRUSTED_ORIGINS=https://learn.witus.online,https://bettervice.club

# Seed account granted is_platform_owner by scripts/seed-tenants.ts
PLATFORM_OWNER_EMAIL=you@example.com

# Local dev: override the resolved tenant host when not using *.localhost subdomains.
# DEV_TENANT_HOST=bvc.localhost

# ── Email (Mailgun) ──────────────────────────────────────────────────────────
# Per-tenant from/reply-to live in the tenants table; this is the platform default.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
MAIL_FROM=Learn.WitUS <no-reply@witus.online>

# ── Stripe (own account) — Phase 5 ───────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI (Gemini) — Phase 6 ────────────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=

# ── Media (Cloudinary) — Phases 4/8 ──────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Self-serve custom domains (Vercel Domains API) ───────────────────────────
# All optional — /admin/domains still maps a host to a school without these, it just
# can't auto-register a CUSTOM domain with Vercel (subdomains of NEXT_PUBLIC_APP_URL's
# zone, e.g. *.learn.witus.online, never need this — a wildcard Vercel domain covers
# them). See src/lib/vercel-domains.ts + plans/user-tasks/64-domain-self-serve-setup.md.
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# ── Demo account (Acme "Try the demo" login + nightly Vercel cron reset) ─────
# All optional — the app boots without them; the demo button/endpoints stay dark
# until set. See src/db/queries/demo.ts + plans/user-tasks/62-demo-account-setup.md.
# CRON_SECRET=replace-with-a-long-random-secret
# DEMO_VISITOR_PASSWORD=replace-with-a-password-min-8-chars
# DEMO_VISITOR_USER_EMAIL=demo@learn.witus.online

# ── Ecosystem (optional, per-tenant flag) ────────────────────────────────────
# FLASHLEARN_ECO_API_KEY=

# "Sign in with WitUS" (OIDC against the ecosystem IdP at accounts.witus.online). The provider is
# only registered when WITUS_OIDC_CLIENT_ID is set, and the button only RENDERS on a WitUS-branded
# host or a tenant with flags.ecosystemSso, so white-label schools stay isolated either way.
# WITUS_OIDC_CLIENT_ID=
# WITUS_OIDC_CLIENT_SECRET=
# Override only if the IdP moves. Defaults to
# https://accounts.witus.online/api/idp/.well-known/openid-configuration
# WITUS_OIDC_DISCOVERY_URL=
#
# The silent "Continue as <name>" check (src/lib/silent-sso.ts). Normally leave UNSET: it is derived
# from the discovery URL above as <idp-origin>/api/idp/get-session. Set it only if the IdP serves
# its session route somewhere else. Two things decide whether it can ever answer:
#   1. WITUS_OIDC_CLIENT_ID must be set, or the check stays dark (an affordance the visitor cannot
#      complete is worse than none).
#   2. The IdP must send CORS headers for this app's origins WITH credentials. That is a change in
#      the witus.online repo, not here. Until it lands the probe fails silently and the button reads
#      "Sign in with WitUS", which is the intended degraded state.
# WITUS_SSO_SESSION_URL=
# The WitUS Inbox. These THREE (not PLATFORM_OWNER_EMAIL) are what turn the email mirror on:
# every email sendEmail() delivers is also recorded in the Inbox — metadata plus a body with all
# token-bearing URLs REDACTED (src/lib/email-redact.ts), so a magic-link/invite token never lands
# in triage. Unset → sendToInbox() no-ops silently and mail is unaffected.
# INBOX_INGEST_URL=
# INBOX_SOURCE_SLUG=
# INBOX_INGEST_SECRET=
